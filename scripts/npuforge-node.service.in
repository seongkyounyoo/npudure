[Unit]
# NPUForge 노드 에이전트.
#
# 왜 이 유닛이 필요한가 (2026-08-20)
#   jack 의 노드 프로세스가 죽어 있었는데 **원인을 확정할 수 없었다.**
#   OOM 도 segfault 도 아니었고, 로그가 아예 없었다. 기동 절차가
#   `setsid nohup ... &` 인데 핸드오프 문서에 로그 리다이렉트가 빠져 있어
#   표준출력이 버려지고 있었다.
#
#   프로세스가 죽는 것보다 **왜 죽었는지 알 수 없는 것이 나쁘다.**
#   systemd 로 옮기면 journald 가 로그를 보관하고, 재시작 정책과 마지막
#   종료 상태(`systemctl status`)가 남는다.
#
# ⚠️ 설치 전에 읽을 것 — 측정 스크립트와 충돌한다
#   `scripts/run-*.sh` 는 1노드 구성을 만들려고 `pkill -9 npuforge-node` 로
#   노드를 죽인다. 여기에 `Restart=always` 를 걸면 systemd 가 즉시 되살려
#   **1노드 측정이 조용히 3노드 측정이 된다.** 결과가 틀리는 게 아니라
#   "틀린 줄 모르는" 종류의 사고다.
#
#   그래서 재시작 정책을 `on-failure` 로 두고, 측정 스크립트는 `pkill` 대신
#   `systemctl stop` 을 쓰도록 함께 바꿔야 한다. 그 전까지는 설치하지 않는다.
#   → `docs/TODO.md` §1.2
Description=NPUForge node agent
Documentation=file:///home/pi/npuforge/node.toml
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/npuforge
ExecStart=/home/pi/npuforge/npuforge-node --config /home/pi/npuforge/node.toml

# 측정 스크립트가 pkill 로 죽이는 것을 "실패" 로 보지 않게 한다.
# SIGKILL(=137) 과 정상 종료는 재시작하지 않는다.
Restart=on-failure
RestartSec=5
SuccessExitStatus=0 SIGKILL

# NPU 컨텍스트 정리에 시간이 필요하다. 성급히 SIGKILL 하면 다음 기동에서
# 컨텍스트를 못 잡는다 (worklog 의 재기동 주의사항과 같은 이유).
KillSignal=SIGTERM
TimeoutStopSec=15

StandardOutput=journal
StandardError=journal
SyslogIdentifier=npuforge-node

[Install]
WantedBy=multi-user.target
